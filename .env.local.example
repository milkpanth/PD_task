# Copy this file to .env.local and fill in your Supabase project values
# (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ── Server-only — required for OpenProject sync (Dev Task <-> OpenProject) ──
# These must NEVER get a NEXT_PUBLIC_ prefix — they are read only inside
# app/api/**/route.js (server), never bundled into the browser.

# Supabase Project Settings -> API -> service_role key (secret).
# Used only by the webhook route to write incoming OpenProject tickets
# without needing a logged-in TaskFlow user session.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# Your OpenProject instance base URL, no trailing slash.
OPENPROJECT_BASE_URL=https://yourcompany.openproject.com

# OpenProject -> My account -> Access token -> API -> Generate.
OPENPROJECT_API_KEY=YOUR-OPENPROJECT-API-KEY

# Any random string you choose. Set the SAME value in OpenProject's webhook
# "Signature secret" field (Administration -> API and webhooks -> Webhooks).
OPENPROJECT_WEBHOOK_SECRET=choose-a-random-secret-string
